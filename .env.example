# Firebase Admin SDK Configuration
# For cloud development/production, set the project ID and service account credentials:
FIREBASE_PROJECT_ID="noteflow-dev"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# For local development with Firebase Local Emulator Suite:
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="development-secret-only-change-in-production-32chars"

# Public base URL of the app (required in production)
AUTH_URL="http://localhost:3000"
